  "scope_action": {
    "name": "Classify CI scope",
    "description": "Complete PR diff classification with full-gate fallback",
    "outputs": {
      "lint": {
        "value": "${{ steps.scope.outputs.lint }}",
        "description": "Root Biome"
      },
      "typecheck": {
        "value": "${{ steps.scope.outputs.typecheck }}",
        "description": "Any Type Check step"
      },
      "root": {
        "value": "${{ steps.scope.outputs.root }}",
        "description": "Root TypeScript"
      },
      "web": {
        "value": "${{ steps.scope.outputs.web }}",
        "description": "Web source and tests"
      },
      "signaling": {
        "value": "${{ steps.scope.outputs.signaling }}",
        "description": "Worker TypeScript"
      },
      "integration": {
        "value": "${{ steps.scope.outputs.integration }}",
        "description": "Relay integration TypeScript"
      },
      "notices": {
        "value": "${{ steps.scope.outputs.notices }}",
        "description": "Bundled dependency notices"
      },
      "test": {
        "value": "${{ steps.scope.outputs.test }}",
        "description": "Full Bun coverage suite"
      },
      "relay": {
        "value": "${{ steps.scope.outputs.relay }}",
        "description": "Short relay wire and authority controls"
      },
      "macos": {
        "value": "${{ steps.scope.outputs.macos }}",
        "description": "macOS shell build and tests"
      },
      "relay_soak": {
        "value": "${{ steps.scope.outputs.relay_soak }}",
        "description": "Actual 61-minute relay gate"
      }
    },
    "runs": {
      "using": "composite",
      "steps": [
        {
          "uses": "astral-sh/setup-uv@d0cc045d04ccac9d8b7881df0226f9e82c39688e",
          "with": {
            "version": "0.12.23",
            "enable-cache": "false"
          }
        },
        {
          "name": "Install pinned workflow validation tools",
          "shell": "bash",
          "run": "set -euo pipefail\nuv pip install --python python3 --only-binary=:all: --target \"$RUNNER_TEMP/remi-ci-python\" PyYAML==6.0.3\nmkdir -p \"$RUNNER_TEMP/remi-ci-tools\"\ncurl -fsSL https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz -o \"$RUNNER_TEMP/remi-ci-tools/actionlint.tar.gz\"\necho '8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8  actionlint.tar.gz' | (cd \"$RUNNER_TEMP/remi-ci-tools\" && sha256sum -c -)\ntar -xzf \"$RUNNER_TEMP/remi-ci-tools/actionlint.tar.gz\" -C \"$RUNNER_TEMP/remi-ci-tools\" actionlint\n"
        },
        {
          "name": "Determine validator scope",
          "id": "validation",
          "shell": "bash",
          "run": "python3 .github/scripts/ci-scope.py --validation-needed"
        },
        {
          "name": "Verify classifier controls",
          "shell": "bash",
          "env": {
            "PYTHONPATH": "${{ runner.temp }}/remi-ci-python",
            "ACTIONLINT": "${{ runner.temp }}/remi-ci-tools/actionlint"
          },
          "run": "python3 .github/scripts/check-ci-scope.py",
          "if": "steps.validation.outputs.validation_required != 'false'"
        },
        {
          "name": "Validate workflow YAML and execution contracts",
          "shell": "bash",
          "env": {
            "PYTHONPATH": "${{ runner.temp }}/remi-ci-python",
            "ACTIONLINT": "${{ runner.temp }}/remi-ci-tools/actionlint"
          },
          "run": "python3 .github/scripts/workflow-scope.py",
          "if": "steps.validation.outputs.validation_required != 'false'"
        },
        {
          "name": "Classify complete diff",
          "id": "scope",
          "shell": "bash",
          "env": {
            "PYTHONPATH": "${{ runner.temp }}/remi-ci-python"
          },
          "run": "python3 .github/scripts/ci-scope.py"
        },
        {
          "name": "Validate mandatory scope outputs",
          "shell": "bash",
          "env": {
            "CI_SCOPE_LINT": "${{ steps.scope.outputs.lint }}",
            "CI_SCOPE_TYPECHECK": "${{ steps.scope.outputs.typecheck }}",
            "CI_SCOPE_ROOT": "${{ steps.scope.outputs.root }}",
            "CI_SCOPE_WEB": "${{ steps.scope.outputs.web }}",
            "CI_SCOPE_SIGNALING": "${{ steps.scope.outputs.signaling }}",
            "CI_SCOPE_INTEGRATION": "${{ steps.scope.outputs.integration }}",
            "CI_SCOPE_NOTICES": "${{ steps.scope.outputs.notices }}",
            "CI_SCOPE_TEST": "${{ steps.scope.outputs.test }}",
            "CI_SCOPE_RELAY": "${{ steps.scope.outputs.relay }}",
            "CI_SCOPE_MACOS": "${{ steps.scope.outputs.macos }}",
            "CI_SCOPE_RELAY_SOAK": "${{ steps.scope.outputs.relay_soak }}"
          },
          "run": "python3 .github/scripts/check-scope-output.py"
        }
      ]
    }
  },
  "relay_reuse_job": {
    "needs": ["scope"],
    "if": "${{ !cancelled() }}",
    "runs-on": "ubuntu-latest",
    "timeout-minutes": "80",
    "permissions": {
      "contents": "read",
      "actions": "read"
    },
    "env": {
      "BUN_VERSION": "1.3.11",
      "E2E_BUNDLER": "esbuild"
    },
    "steps": [
      {
        "name": "Fail unvalidated scope",
        "if": "needs.scope.result != 'success'",
        "run": "echo \"CI scope validation failed; runtime checks were not started.\" >&2\nexit 1\n"
      },
      {
        "uses": "actions/checkout@v5",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false'",
        "with": {
          "fetch-depth": "0"
        }
      },
      {
        "uses": "actions/setup-node@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false'",
        "with": {
          "node-version": "24"
        }
      },
      {
        "uses": "oven-sh/setup-bun@v2",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false'",
        "with": {
          "bun-version": "${{ env.BUN_VERSION }}"
        }
      },
      {
        "run": "bun install --frozen-lockfile",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false'"
      },
      {
        "name": "Existing actual wire and authority controls",
        "id": "wire",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false'",
        "shell": "bash",
        "run": "set -o pipefail\nmkdir -p r7-receipts\ngit rev-parse HEAD | tee r7-receipts/head.txt\nbun --version | tee r7-receipts/bun.txt\nbun test packages/signaling/tests/e2e \\\n  packages/web/tests/relay-machine-channel.test.ts \\\n  packages/web/tests/relay-client-outcomes.test.ts \\\n  tests/integration/relay-r3*.test.ts \\\n  tests/integration/relay-r6-ingress.test.ts \\\n  tests/integration/relay-r7*.test.ts 2>&1 | tee r7-receipts/controls.log\n"
      },
      {
        "name": "Check completed soak evidence",
        "id": "reuse",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay_soak != 'false'",
        "env": {
          "GH_TOKEN": "${{ github.token }}"
        },
        "run": "python3 .github/scripts/relay-soak-reuse.py"
      },
      {
        "name": "Same attached session for 61 actual minutes",
        "id": "soak",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay_soak != 'false' && steps.reuse.outputs.verified != 'true'",
        "shell": "bash",
        "env": {
          "REMI_RELAY_R7_SOAK": "1"
        },
        "run": "set -o pipefail\nbun test --timeout 4500000 packages/web/tests/relay-r7-soak.test.ts 2>&1 | tee r7-receipts/soak.log\n"
      },
      {
        "name": "Record actual soak producer",
        "if": "needs.scope.result == 'success' && steps.wire.conclusion == 'success' && steps.soak.conclusion == 'success'",
        "env": {
          "GH_TOKEN": "${{ github.token }}",
          "SHORT_CONCLUSION": "${{ steps.wire.conclusion }}",
          "SOAK_CONCLUSION": "${{ steps.soak.conclusion }}"
        },
        "run": "python3 .github/scripts/relay-soak-reuse.py --write-receipt"
      },
      {
        "uses": "actions/upload-artifact@v4",
        "if": "always() && (needs.scope.result == 'success' && needs.scope.outputs.relay != 'false')",
        "with": {
          "name": "relay-r7-local-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "r7-receipts/"
        }
      },
      {
        "name": "Report scoped skip",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay == 'false'",
        "run": "echo \"Relay gate skipped; no relay inputs changed.\" >> \"$GITHUB_STEP_SUMMARY\""
      },
      {
        "name": "Report scoped soak skip",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.relay != 'false' && needs.scope.outputs.relay_soak == 'false'",
        "run": "echo \"61-minute soak scoped out for exact reviewed input transitions; short relay controls remain required.\" >> \"$GITHUB_STEP_SUMMARY\""
      }
    ]
  },
  "test_worker_job": {
    "name": "Test worker ${{ matrix.worker }}",
    "runs-on": "ubuntu-latest",
    "needs": ["scope"],
    "if": "${{ !cancelled() }}",
    "timeout-minutes": "25",
    "strategy": {
      "fail-fast": "false",
      "matrix": {
        "worker": ["0", "1", "2"]
      }
    },
    "steps": [
      {
        "name": "Fail unvalidated scope",
        "if": "needs.scope.result != 'success'",
        "run": "echo \"CI scope validation failed; runtime checks were not started.\" >&2\nexit 1\n"
      },
      {
        "uses": "actions/checkout@v5",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'"
      },
      {
        "uses": "actions/setup-node@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "node-version": "24"
        }
      },
      {
        "uses": "oven-sh/setup-bun@v2",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "bun-version": "${{ env.BUN_VERSION }}"
        }
      },
      {
        "run": "bun install --frozen-lockfile",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'"
      },
      {
        "name": "Test with coverage",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "env": {
          "E2E_BUNDLER": "esbuild"
        },
        "run": "set -o pipefail\nbun scripts/ci/run-bun-test-batches.ts --worker=${{ matrix.worker }} 2>&1 | tee test-batches-output.txt\n"
      },
      {
        "name": "Upload worker evidence",
        "if": "always() && needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "uses": "actions/upload-artifact@v4",
        "with": {
          "name": "test-worker-${{ matrix.worker }}-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "coverage/test-lanes/",
          "if-no-files-found": "error",
          "retention-days": "14"
        }
      },
      {
        "name": "Upload worker log",
        "if": "always() && needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "uses": "actions/upload-artifact@v4",
        "with": {
          "name": "test-worker-log-${{ matrix.worker }}-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "test-batches-output.txt",
          "if-no-files-found": "error",
          "retention-days": "14"
        }
      },
      {
        "name": "Report scoped skip",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test == 'false'",
        "run": "echo \"test skipped; no relevant inputs changed.\" >> \"$GITHUB_STEP_SUMMARY\""
      }
    ]
  },
  "test_aggregate_job": {
    "name": "Test",
    "runs-on": "ubuntu-latest",
    "needs": ["scope", "test-workers"],
    "if": "${{ !cancelled() }}",
    "timeout-minutes": "25",
    "steps": [
      {
        "name": "Fail unvalidated scope",
        "if": "needs.scope.result != 'success'",
        "run": "echo \"CI scope validation failed; runtime checks were not started.\" >&2\nexit 1\n"
      },
      {
        "name": "Fail incomplete test workers",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false' && needs.test-workers.result != 'success'",
        "run": "echo \"Every test worker must pass before coverage can be aggregated.\" >&2\nexit 1\n"
      },
      {
        "uses": "actions/checkout@v5",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'"
      },
      {
        "uses": "actions/setup-node@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "node-version": "24"
        }
      },
      {
        "uses": "oven-sh/setup-bun@v2",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "bun-version": "${{ env.BUN_VERSION }}"
        }
      },
      {
        "run": "bun install --frozen-lockfile",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'"
      },
      {
        "uses": "actions/download-artifact@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "name": "test-worker-0-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "coverage/test-workers/worker-0"
        }
      },
      {
        "uses": "actions/download-artifact@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "name": "test-worker-1-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "coverage/test-workers/worker-1"
        }
      },
      {
        "uses": "actions/download-artifact@v4",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "with": {
          "name": "test-worker-2-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "coverage/test-workers/worker-2"
        }
      },
      {
        "name": "Aggregate coverage",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "run": "set -o pipefail\nbun scripts/ci/run-bun-test-batches.ts --aggregate 2>&1 | tee test-batches-output.txt\n"
      },
      {
        "name": "Check coverage threshold",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "run": "# The \"All files\" row is pipe-delimited: File | % Funcs | % Lines | Uncovered.\n# Treat the stream as text: test-runner diagnostics may contain NUL/control bytes.\n# % Lines is the 3rd field. Strip ANSI colour codes first (bun colourises\n# on a TTY) and fail loudly if parsing yields a non-number \u2014 the previous\n# `awk '{print $NF}'` extracted the trailing \"|\", silently passing the gate.\nCOVERAGE=$(grep -a \"All files\" test-output.txt | head -1 \\\n  | sed 's/\\x1b\\[[0-9;]*m//g' | awk -F'|' '{gsub(/[[:space:]]/,\"\",$3); print $3}' | tr -d '%')\necho \"Line coverage: ${COVERAGE}%\"\nif ! echo \"$COVERAGE\" | grep -qE '^[0-9]+(\\.[0-9]+)?$'; then\n  echo \"Could not parse line coverage from bun output\"\n  exit 1\nfi\nif [ \"$(echo \"$COVERAGE < 60\" | bc -l)\" -eq 1 ]; then\n  echo \"Coverage ${COVERAGE}% is below 60% threshold\"\n  exit 1\nfi\n"
      },
      {
        "name": "Upload test evidence",
        "if": "always() && needs.scope.result == 'success' && needs.scope.outputs.test != 'false'",
        "uses": "actions/upload-artifact@v4",
        "with": {
          "name": "test-evidence-${{ github.run_id }}-${{ github.run_attempt }}",
          "path": "coverage/test-workers/\ncoverage/test-aggregate/\ntest-batches-output.txt\ntest-output.txt\n",
          "if-no-files-found": "error",
          "retention-days": "14"
        }
      },
      {
        "name": "Report scoped skip",
        "if": "needs.scope.result == 'success' && needs.scope.outputs.test == 'false'",
        "run": "echo \"test skipped; no relevant inputs changed.\" >> \"$GITHUB_STEP_SUMMARY\""
      }
    ]
  }
}
