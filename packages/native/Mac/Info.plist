<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_remi._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Remi finds and reconnects to your saved machines on the local network.</string>
	<key>RemiSourceCommit</key>
	<string>$(REMI_SOURCE_COMMIT)</string>
	<key>RemiPushAppGroup</key>
	<string>$(DEVELOPMENT_TEAM).live.yooz.remi</string>
	<key>RemiPushNamespace</key>
	<string>$(REMI_PUSH_NAMESPACE)</string>
	<key>RemiPushAccessGroup</key>
	<string>$(AppIdentifierPrefix)live.yooz.remi.secure-push</string>
	<key>RemiIdentityAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
</dict>
</plist>
