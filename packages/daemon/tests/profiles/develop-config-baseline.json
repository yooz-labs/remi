{
  "harness": {
    "default": "claude"
  },
  "daemon": {
    "tls": null,
    "base_port": 18765,
    "port_range": 20,
    "bind": "127.0.0.2",
    "orphan_timeout": 300,
    "persist_sessions": true,
    "allowed_origins": []
  },
  "awake": {
    "level1": true,
    "question_hold_minutes": 30,
    "idle_grace_seconds": 120,
    "stuck_busy_minutes": 15,
    "ttl_minutes": 20
  },
  "network": {
    "mdns": true,
    "relay": false,
    "signaling_url": "wss://remi-signaling.yooz.workers.dev"
  },
  "auth": {
    "enabled": "auto"
  },
  "display": {
    "max_bullet_length": 500
  },
  "terminal": {
    "notify": "osc9",
    "status_cue": true,
    "status_bar": true
  },
  "telegram": {
    "enabled": false,
    "bot_token": "",
    "authorized_chat_ids": [],
    "authorized_user_ids": []
  },
  "features": {
    "transcript_binder_enabled": true
  },
  "notifications": {
    "legacy_push_enabled": true,
    "on_turn_complete": true,
    "turn_complete_min_seconds": 60,
    "push_lease_hours": 720,
    "subagent_alert": [
      "rm -rf",
      "rm -f",
      "push --force",
      "push -f ",
      "reset --hard",
      "DROP TABLE",
      "TRUNCATE",
      "sudo ",
      "chmod 777"
    ]
  },
  "prompts": {
    "hold_seconds": 90,
    "daemon_hold_seconds": 3540
  }
}
