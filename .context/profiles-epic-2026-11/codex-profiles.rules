# Codex execpolicy rules for profiles-epic-2026-11 workers (forbidden commands).
# Carried over from land-branches-2026-11 (codex-landing.rules) with sign-in and keychain commands added.
# Plain `codex login` (the browser flow) cannot be forbidden here without also forbidding
# `codex login status`, which P1C needs; the worker preamble forbids it.
# Writing `gh issue` verbs are forbidden one by one so `gh issue view` stays allowed (pack review E5);
# all of `security` (the keychain tool), `claude setup-token` and `remi profile login` added (D21).
# Verified with codex-cli 0.167.0 on 2026-11-14 (`codex execpolicy check --rules THIS_FILE ...`):
#   forbidden: gh pr merge 1 --merge; gh issue comment 1 --body x; gh issue create --title x;
#              claude auth login; claude setup-token; codex login --with-api-key;
#              security find-generic-password -s x; remi profile login work; pkill -f remi
#   no match:  gh issue view 1748 --repo yooz-labs/remi; claude auth status --json;
#              codex login status; remi profile ls; git push origin feature/x
# Not verified: that `codex exec` loads a file placed in ~/.codex/rules, or that it applies
# rules under -s danger-full-access. Installing it changes the owner's global Codex config.
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "close"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "create"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "close"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "comment"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "reopen"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "delete"], decision = "forbidden")
prefix_rule(pattern = ["gh", "issue", "transfer"], decision = "forbidden")
prefix_rule(pattern = ["gh", "release"], decision = "forbidden")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden")
prefix_rule(pattern = ["git", "push", "origin", "develop"], decision = "forbidden")
prefix_rule(pattern = ["git", "push", "origin", "main"], decision = "forbidden")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden")
prefix_rule(pattern = ["claude", "auth", "login"], decision = "forbidden")
prefix_rule(pattern = ["claude", "auth", "logout"], decision = "forbidden")
prefix_rule(pattern = ["codex", "logout"], decision = "forbidden")
prefix_rule(pattern = ["codex", "login", "--with-api-key"], decision = "forbidden")
prefix_rule(pattern = ["codex", "login", "--with-access-token"], decision = "forbidden")
prefix_rule(pattern = ["codex", "login", "--device-auth"], decision = "forbidden")
prefix_rule(pattern = ["security"], decision = "forbidden")
prefix_rule(pattern = ["claude", "setup-token"], decision = "forbidden")
prefix_rule(pattern = ["remi", "profile", "login"], decision = "forbidden")
prefix_rule(pattern = ["pkill"], decision = "forbidden")
prefix_rule(pattern = ["killall"], decision = "forbidden")
